<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="InclinationTest.App.Components.Layout.ScreenHeader"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid RowDefinitions="64,1">
        <Grid
            Grid.Row="0"
            Padding="16,0"
            BackgroundColor="{StaticResource SurfaceHeader}"
            ColumnDefinitions="*,Auto,*">

            <ContentView
                x:Name="LeftSlot"
                Grid.Column="0"
                HorizontalOptions="Start"
                VerticalOptions="Center" />

            <Label
                Grid.Column="1"
                FontFamily="{StaticResource FontDisplay}"
                FontSize="18"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                MaxLines="1"
                Text="{Binding Title, Source={x:Reference Root}}"
                TextColor="{StaticResource OnSurface}"
                TextTransform="Uppercase"
                VerticalOptions="Center"
                CharacterSpacing="0.5" />

            <ContentView
                x:Name="RightSlot"
                Grid.Column="2"
                HorizontalOptions="End"
                VerticalOptions="Center" />
        </Grid>

        <BoxView
            Grid.Row="1"
            BackgroundColor="#33515d5c" />
    </Grid>
</ContentView>
