<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Arquivo único de design (design override).
    Para reestilizar o app inteiro, altere somente os valores deste arquivo.
    Todas as telas/componentes referenciam estas chaves semânticas via StaticResource.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Superfícies -->
    <Color x:Key="AppBackground">#0b1220</Color>
    <Color x:Key="SurfaceElevated">#111a2e</Color>
    <Color x:Key="SurfaceCard">#16203a</Color>
    <Color x:Key="SurfaceBorder">#22304f</Color>

    <!-- Texto -->
    <Color x:Key="TextPrimary">#e8edf6</Color>
    <Color x:Key="TextMuted">#8b98b4</Color>
    <Color x:Key="TextOnAccent">#05150d</Color>

    <!-- Cores de marca / acao -->
    <Color x:Key="Accent">#f5a623</Color>
    <Color x:Key="AccentStrong">#ffb93f</Color>
    <Color x:Key="Ok">#34c98a</Color>
    <Color x:Key="Warn">#f5a623</Color>
    <Color x:Key="Danger">#ff5c5c</Color>
    <Color x:Key="RecordRed">#d92b2b</Color>
    <Color x:Key="RecordRedLight">#ff6b6b</Color>

    <!-- Grafico -->
    <Color x:Key="ChartTrim">#4aa3ff</Color>
    <Color x:Key="ChartRoll">#f5a623</Color>

    <!-- Compatibilidade de nomes usados nos componentes -->
    <Color x:Key="TrimLine">#4aa3ff</Color>

    <!-- Espacamentos -->
    <x:Double x:Key="SpacingXs">4</x:Double>
    <x:Double x:Key="SpacingSm">8</x:Double>
    <x:Double x:Key="SpacingMd">16</x:Double>
    <x:Double x:Key="SpacingLg">24</x:Double>

    <!-- Raios -->
    <x:Double x:Key="RadiusSm">12</x:Double>
    <x:Double x:Key="RadiusMd">16</x:Double>
    <x:Double x:Key="RadiusPill">18</x:Double>

</ResourceDictionary>
