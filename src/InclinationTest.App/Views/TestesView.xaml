<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="InclinationTest.App.Views.TestesView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:icons="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:layout="clr-namespace:InclinationTest.App.Components.Layout">

    <Grid RowDefinitions="Auto,*" BackgroundColor="{StaticResource Surface}">
        <layout:ScreenHeader Grid.Row="0" Title="Testes">
            <layout:ScreenHeader.LeftContent>
                <Border
                    Padding="8,5"
                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                    StrokeShape="RoundRectangle 999"
                    StrokeThickness="0">
                    <HorizontalStackLayout Spacing="6">
                        <Ellipse
                            Fill="{StaticResource Outline}"
                            HeightRequest="7"
                            VerticalOptions="Center"
                            WidthRequest="7" />
                        <Label
                            FontFamily="{StaticResource FontMono}"
                            FontAttributes="Bold"
                            FontSize="10"
                            Text="IMU N/D"
                            TextColor="{StaticResource OnSurfaceVariant}"
                            CharacterSpacing="0.8" />
                    </HorizontalStackLayout>
                </Border>
            </layout:ScreenHeader.LeftContent>
        </layout:ScreenHeader>

        <Grid
            Grid.Row="1"
            Padding="16,24">
            <Border
                Padding="24,40"
                BackgroundColor="{StaticResource SurfaceContainer}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                VerticalOptions="Center">
                <Border.Shadow>
                    <Shadow
                        Brush="#66000000"
                        Offset="0,4"
                        Radius="12" />
                </Border.Shadow>

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    Spacing="16"
                    VerticalOptions="Center">
                    <Grid
                        HeightRequest="64"
                        HorizontalOptions="Center"
                        WidthRequest="64">
                        <Border
                            BackgroundColor="#3348efef"
                            HeightRequest="64"
                            StrokeShape="RoundRectangle 999"
                            StrokeThickness="0"
                            WidthRequest="64" />
                        <Border
                            HeightRequest="48"
                            BackgroundColor="{StaticResource SurfaceContainerHigh}"
                            HorizontalOptions="Center"
                            StrokeShape="RoundRectangle 999"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="48">
                            <Label
                                FontFamily="{StaticResource FontIcons}"
                                FontSize="30"
                                HorizontalOptions="Center"
                                Text="{x:Static icons:MaterialOutlined.Science}"
                                TextColor="{StaticResource Primary}"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <Border
                        Padding="10,4"
                        BackgroundColor="{StaticResource SurfaceContainerHighest}"
                        HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 999"
                        StrokeThickness="0">
                        <HorizontalStackLayout Spacing="6">
                            <Ellipse
                                Fill="{StaticResource Primary}"
                                HeightRequest="5"
                                VerticalOptions="Center"
                                WidthRequest="5" />
                            <Label
                                FontFamily="{StaticResource FontMono}"
                                FontAttributes="Bold"
                                FontSize="10"
                                Text="DIAGNÓSTICO NAVAL"
                                TextColor="{StaticResource Primary}"
                                CharacterSpacing="1.2" />
                        </HorizontalStackLayout>
                    </Border>

                    <Label
                        FontFamily="{StaticResource FontBody}"
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        LineHeight="1.4"
                        MaximumWidthRequest="280"
                        Text="Tela Testes (Integridade) aguardando especificação."
                        TextColor="{StaticResource OnSurface}" />

                    <BoxView
                        HeightRequest="1"
                        Margin="0,8,0,0"
                        BackgroundColor="{StaticResource OutlineVariant}" />

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Label
                            FontFamily="{StaticResource FontMono}"
                            FontAttributes="Bold"
                            FontSize="10"
                            Text="MÓDULO TELEMETRIA"
                            TextColor="{StaticResource OnSurfaceVariant}"
                            CharacterSpacing="0.8" />
                        <Ellipse
                            Fill="{StaticResource OutlineVariant}"
                            HeightRequest="3"
                            VerticalOptions="Center"
                            WidthRequest="3" />
                        <Label
                            FontFamily="{StaticResource FontMono}"
                            FontAttributes="Bold"
                            FontSize="10"
                            Text="AGUARDANDO ESPECIFICAÇÃO"
                            TextColor="{StaticResource Primary}"
                            CharacterSpacing="0.8" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentView>
