<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="InclinationTest.App.Views.ConfiguracoesView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:icons="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:layout="clr-namespace:InclinationTest.App.Components.Layout"
    BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*" BackgroundColor="{StaticResource Surface}">
        <layout:ScreenHeader Grid.Row="0" Title="Conta" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,12,16,32" Spacing="16">

                <!-- SEÇÃO 1: CONFIGURAÇÃO DA CONTA -->
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontFamily="{StaticResource FontMono}"
                        FontSize="11"
                        FontAttributes="Bold"
                        Text="CONFIGURAÇÃO DA CONTA"
                        TextColor="{StaticResource Primary}"
                        CharacterSpacing="1.2" />

                    <Border
                        Padding="16"
                        BackgroundColor="{StaticResource SurfaceContainer}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="14">
                            <!-- Status da Conta / Usuário -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border
                                    HeightRequest="42"
                                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                    StrokeShape="RoundRectangle 999"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="42">
                                    <Label
                                        x:Name="CloudStatusIcon"
                                        FontFamily="{StaticResource FontIcons}"
                                        FontSize="24"
                                        HorizontalOptions="Center"
                                        Text="{x:Static icons:MaterialOutlined.Cloud_off}"
                                        TextColor="{StaticResource Primary}"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        FontFamily="{StaticResource FontDisplay}"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        Text="Usuário da Plataforma"
                                        TextColor="{StaticResource OnSurface}" />
                                    <Label
                                        x:Name="CloudAccountLabel"
                                        FontFamily="{StaticResource FontMono}"
                                        FontSize="11"
                                        Text="Modo Local (Offline) — Login opcional"
                                        TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                                <Border
                                    x:Name="CloudAuthActionBorder"
                                    Grid.Column="2"
                                    Padding="14,8"
                                    BackgroundColor="{StaticResource PrimaryContainer}"
                                    StrokeShape="RoundRectangle 999"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAuthActionTapped" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        x:Name="CloudAuthActionLabel"
                                        FontFamily="{StaticResource FontMono}"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        Text="CONECTAR"
                                        TextColor="{StaticResource OnPrimaryContainer}"
                                        CharacterSpacing="0.8" />
                                </Border>
                            </Grid>

                            <Label
                                FontFamily="{StaticResource FontBody}"
                                FontSize="12"
                                LineHeight="1.35"
                                Text="O login na nuvem é opcional. Todos os ensaios permanecem salvos com segurança no dispositivo localmente, mesmo sem conexão à internet."
                                TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- SEÇÃO 2: SINCRONIZAÇÃO EM NUVEM -->
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontFamily="{StaticResource FontMono}"
                        FontSize="11"
                        FontAttributes="Bold"
                        Text="SINCRONIZAÇÃO EM NUVEM"
                        TextColor="{StaticResource Primary}"
                        CharacterSpacing="1.2" />

                    <Border
                        Padding="16"
                        BackgroundColor="{StaticResource SurfaceContainer}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="14">
                            <!-- Sincronização Automática (SIM ou NÃO) -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border
                                    HeightRequest="36"
                                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="36">
                                    <Label
                                        FontFamily="{StaticResource FontIcons}"
                                        FontSize="20"
                                        HorizontalOptions="Center"
                                        Text="{x:Static icons:MaterialOutlined.Sync}"
                                        TextColor="{StaticResource Primary}"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        Text="Sincronização automática"
                                        TextColor="{StaticResource OnSurface}" />
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="11"
                                        Text="Enviar medições para a nuvem automaticamente ao finalizar ensaio"
                                        TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                                <Switch
                                    x:Name="AutoSyncSwitch"
                                    Grid.Column="2"
                                    IsToggled="True"
                                    Toggled="OnAutoSyncToggled"
                                    VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource OutlineVariant}" />

                            <!-- Sincronização Manual -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border
                                    HeightRequest="36"
                                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="36">
                                    <Label
                                        FontFamily="{StaticResource FontIcons}"
                                        FontSize="20"
                                        HorizontalOptions="Center"
                                        Text="{x:Static icons:MaterialOutlined.Cloud_upload}"
                                        TextColor="{StaticResource Secondary}"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        Text="Sincronizar agora"
                                        TextColor="{StaticResource OnSurface}" />
                                    <Label
                                        x:Name="SyncCountLabel"
                                        FontFamily="{StaticResource FontMono}"
                                        FontSize="11"
                                        Text="Toque para enviar relatórios pendentes"
                                        TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                                <Border
                                    Grid.Column="2"
                                    Padding="12,6"
                                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                    StrokeShape="RoundRectangle 999"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSyncNowTapped" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        FontFamily="{StaticResource FontMono}"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        Text="SINCRONIZAR"
                                        TextColor="{StaticResource Primary}"
                                        CharacterSpacing="0.8" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- SEÇÃO 3: SEGURANÇA E ARMAZENAMENTO -->
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontFamily="{StaticResource FontMono}"
                        FontSize="11"
                        FontAttributes="Bold"
                        Text="SEGURANÇA E ARMAZENAMENTO LOCAL"
                        TextColor="{StaticResource Primary}"
                        CharacterSpacing="1.2" />

                    <Border
                        Padding="16"
                        BackgroundColor="{StaticResource SurfaceContainer}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border
                                    HeightRequest="36"
                                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="36">
                                    <Label
                                        FontFamily="{StaticResource FontIcons}"
                                        FontSize="20"
                                        HorizontalOptions="Center"
                                        Text="{x:Static icons:MaterialOutlined.Lock}"
                                        TextColor="{StaticResource Primary}"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        Text="Armazenamento seguro de Token (KeyStore)"
                                        TextColor="{StaticResource OnSurface}" />
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="11"
                                        Text="Tokens protegidos por hardware criptográfico e SecureStorage"
                                        TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource OutlineVariant}" />

                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    Text="Exportação de Relatórios"
                                    TextColor="{StaticResource OnSurface}" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="{StaticResource FontMono}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    Text="PDF Oficial + CSV"
                                    TextColor="{StaticResource Secondary}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- SEÇÃO 4: PREFERÊNCIAS DE ENSAIO -->
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontFamily="{StaticResource FontMono}"
                        FontSize="11"
                        FontAttributes="Bold"
                        Text="PREFERÊNCIAS DE ENSAIO"
                        TextColor="{StaticResource Primary}"
                        CharacterSpacing="1.2" />

                    <Border
                        Padding="16"
                        BackgroundColor="{StaticResource SurfaceContainer}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border
                                    HeightRequest="36"
                                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="36">
                                    <Label
                                        FontFamily="{StaticResource FontIcons}"
                                        FontSize="20"
                                        HorizontalOptions="Center"
                                        Text="{x:Static icons:MaterialOutlined.Wb_sunny}"
                                        TextColor="{StaticResource Primary}"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        Text="Manter tela ligada"
                                        TextColor="{StaticResource OnSurface}" />
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="11"
                                        Text="Evita bloqueio automático durante o ensaio"
                                        TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="2" IsToggled="True" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource OutlineVariant}" />

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border
                                    HeightRequest="36"
                                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="36">
                                    <Label
                                        FontFamily="{StaticResource FontIcons}"
                                        FontSize="20"
                                        HorizontalOptions="Center"
                                        Text="{x:Static icons:MaterialOutlined.Vibration}"
                                        TextColor="{StaticResource Primary}"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        Text="Feedback tátil (vibração)"
                                        TextColor="{StaticResource OnSurface}" />
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="11"
                                        Text="Vibra ao iniciar, pausar e salvar gravação"
                                        TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="2" IsToggled="True" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- SEÇÃO 5: SOBRE O SISTEMA -->
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontFamily="{StaticResource FontMono}"
                        FontSize="11"
                        FontAttributes="Bold"
                        Text="SOBRE O APLICATIVO"
                        TextColor="{StaticResource Primary}"
                        CharacterSpacing="1.2" />

                    <Border
                        Padding="16"
                        BackgroundColor="{StaticResource SurfaceContainer}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    FontFamily="{StaticResource FontDisplay}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    Text="Inclination Test"
                                    TextColor="{StaticResource OnSurface}" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="{StaticResource FontMono}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    Text="v1.0.0"
                                    TextColor="{StaticResource Primary}" />
                            </Grid>
                            <Label
                                FontFamily="{StaticResource FontBody}"
                                FontSize="12"
                                Text="Sistema de telemetria marítima desenvolvido para provas de mar, ensaios de estabilidade, medições de banda (Roll) e compasso (Trim)."
                                TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- MODAL DE LOGIN / CADASTRO OPCIONAL -->
        <Grid
            x:Name="LoginOverlay"
            BackgroundColor="{StaticResource Scrim}"
            IsVisible="False"
            ZIndex="30">
            <BoxView BackgroundColor="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseLoginTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border
                Margin="20"
                Padding="24"
                BackgroundColor="{StaticResource SurfaceContainer}"
                MaximumWidthRequest="420"
                StrokeShape="RoundRectangle 24"
                StrokeThickness="0"
                VerticalOptions="Center">
                <VerticalStackLayout Spacing="16">
                    <!-- CABEÇALHO DO MODAL -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border
                            HeightRequest="36"
                            BackgroundColor="#3348efef"
                            StrokeShape="RoundRectangle 999"
                            StrokeThickness="0"
                            WidthRequest="36">
                            <Label
                                FontFamily="{StaticResource FontIcons}"
                                FontSize="20"
                                HorizontalOptions="Center"
                                Text="{x:Static icons:MaterialOutlined.Cloud_done}"
                                TextColor="{StaticResource Primary}"
                                VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label
                                x:Name="ModalTitleLabel"
                                FontFamily="{StaticResource FontDisplay}"
                                FontSize="17"
                                FontAttributes="Bold"
                                Text="Conta Supabase"
                                TextColor="{StaticResource OnSurface}" />
                            <Label
                                FontFamily="{StaticResource FontMono}"
                                FontSize="10"
                                Text="TELEMETRIA EM NUVEM • REST API"
                                TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                        <Label
                            Grid.Column="2"
                            FontFamily="{StaticResource FontIcons}"
                            FontSize="22"
                            Text="{x:Static icons:MaterialOutlined.Close}"
                            TextColor="{StaticResource OnSurfaceVariant}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseLoginTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- SELETOR ENTRAR / CADASTRAR -->
                    <Border
                        BackgroundColor="{StaticResource SurfaceContainerHigh}"
                        Padding="3"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0">
                        <Grid ColumnDefinitions="*,*">
                            <Border
                                x:Name="TabLoginBorder"
                                BackgroundColor="{StaticResource Primary}"
                                HeightRequest="36"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSelectLoginTabTapped" />
                                </Border.GestureRecognizers>
                                <Label
                                    x:Name="TabLoginLabel"
                                    FontFamily="{StaticResource FontMono}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    Text="ENTRAR"
                                    TextColor="{StaticResource OnPrimary}"
                                    VerticalOptions="Center" />
                            </Border>

                            <Border
                                x:Name="TabRegisterBorder"
                                Grid.Column="1"
                                BackgroundColor="Transparent"
                                HeightRequest="36"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSelectRegisterTabTapped" />
                                </Border.GestureRecognizers>
                                <Label
                                    x:Name="TabRegisterLabel"
                                    FontFamily="{StaticResource FontMono}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    Text="CADASTRAR"
                                    TextColor="{StaticResource OnSurfaceVariant}"
                                    VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- CAMPO NOME (VISÍVEL NO CADASTRO) -->
                    <VerticalStackLayout x:Name="NameContainer" IsVisible="False" Spacing="6">
                        <Label
                            FontFamily="{StaticResource FontMono}"
                            FontSize="12"
                            Text="Nome do Operador / Embarcação"
                            TextColor="{StaticResource OnSurfaceVariant}" />
                        <Border
                            Padding="12,0"
                            BackgroundColor="{StaticResource SurfaceContainerLowest}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0">
                            <Entry
                                x:Name="NameEntry"
                                HeightRequest="46"
                                Placeholder="Capitão Silva / Inspetor Naval" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- CAMPO EMAIL -->
                    <VerticalStackLayout Spacing="6">
                        <Label
                            FontFamily="{StaticResource FontMono}"
                            FontSize="12"
                            Text="E-mail"
                            TextColor="{StaticResource OnSurfaceVariant}" />
                        <Border
                            Padding="12,0"
                            BackgroundColor="{StaticResource SurfaceContainerLowest}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0">
                            <Entry
                                x:Name="EmailEntry"
                                HeightRequest="46"
                                Keyboard="Email"
                                Placeholder="capitao@embarcacao.com" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- CAMPO SENHA -->
                    <VerticalStackLayout Spacing="6">
                        <Label
                            FontFamily="{StaticResource FontMono}"
                            FontSize="12"
                            Text="Senha"
                            TextColor="{StaticResource OnSurfaceVariant}" />
                        <Border
                            Padding="12,0"
                            BackgroundColor="{StaticResource SurfaceContainerLowest}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0">
                            <Entry
                                x:Name="PasswordEntry"
                                HeightRequest="46"
                                IsPassword="True"
                                Placeholder="Mínimo 6 caracteres" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- LINK ALTERNAR MODO -->
                    <Label
                        x:Name="ToggleModeLink"
                        FontFamily="{StaticResource FontBody}"
                        FontSize="12"
                        HorizontalTextAlignment="Center"
                        Text="Não tem uma conta? Toque para cadastrar."
                        TextColor="{StaticResource Primary}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnToggleAuthModeTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- MENSAGEM DE ERRO OU SUCESSO -->
                    <Label
                        x:Name="LoginErrorLabel"
                        FontFamily="{StaticResource FontBody}"
                        FontSize="12"
                        HorizontalTextAlignment="Center"
                        IsVisible="False"
                        TextColor="{StaticResource Error}" />

                    <!-- BOTÕES DE AÇÃO -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                        <Border
                            Padding="0,14"
                            BackgroundColor="{StaticResource SurfaceContainerHigh}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseLoginTapped" />
                            </Border.GestureRecognizers>
                            <Label
                                FontFamily="{StaticResource FontBody}"
                                FontSize="13"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                Text="Ficar Offline"
                                TextColor="{StaticResource OnSurface}" />
                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="0,14"
                            BackgroundColor="{StaticResource Primary}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSubmitLoginTapped" />
                            </Border.GestureRecognizers>
                            <Label
                                x:Name="SubmitAuthLabel"
                                FontFamily="{StaticResource FontBody}"
                                FontSize="13"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                Text="Entrar / Conectar"
                                TextColor="{StaticResource OnPrimary}" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentView>
