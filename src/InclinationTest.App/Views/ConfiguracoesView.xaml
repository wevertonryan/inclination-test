<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="InclinationTest.App.Views.ConfiguracoesView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:icons="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:layout="clr-namespace:InclinationTest.App.Components.Layout">

    <Grid RowDefinitions="Auto,*" BackgroundColor="{StaticResource Surface}">
        <layout:ScreenHeader Grid.Row="0" Title="Configurações">
            <layout:ScreenHeader.LeftContent>
                <Border
                    Padding="8,5"
                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                    StrokeShape="RoundRectangle 999"
                    StrokeThickness="0">
                    <HorizontalStackLayout Spacing="6">
                        <Ellipse
                            Fill="{StaticResource Outline}"
                            HeightRequest="7"
                            VerticalOptions="Center"
                            WidthRequest="7" />
                        <Label
                            FontFamily="{StaticResource FontMono}"
                            FontAttributes="Bold"
                            FontSize="10"
                            Text="IMU N/D"
                            TextColor="{StaticResource OnSurfaceVariant}"
                            CharacterSpacing="0.8" />
                    </HorizontalStackLayout>
                </Border>
            </layout:ScreenHeader.LeftContent>
        </layout:ScreenHeader>

        <Grid
            Grid.Row="1"
            Padding="16,24">
            <Border
                Padding="24,32"
                BackgroundColor="{StaticResource SurfaceContainer}"
                MaximumWidthRequest="400"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                VerticalOptions="Center">
                <Border.Shadow>
                    <Shadow
                        Brush="#66000000"
                        Offset="0,4"
                        Radius="12" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    <Border
                        HeightRequest="48"
                        BackgroundColor="{StaticResource SurfaceContainerHigh}"
                        HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 999"
                        StrokeThickness="0"
                        WidthRequest="48">
                        <Label
                            FontFamily="{StaticResource FontIcons}"
                            FontSize="24"
                            HorizontalOptions="Center"
                            Text="{x:Static icons:MaterialOutlined.Construction}"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="10">
                        <Border
                            Padding="8,4"
                            BackgroundColor="{StaticResource SurfaceContainerHigh}"
                            HorizontalOptions="Center"
                            StrokeShape="RoundRectangle 999"
                            StrokeThickness="0">
                            <Label
                                FontFamily="{StaticResource FontMono}"
                                FontAttributes="Bold"
                                FontSize="10"
                                Text="MÓDULO DE AJUSTES"
                                TextColor="{StaticResource Primary}"
                                CharacterSpacing="1.2" />
                        </Border>
                        <Label
                            FontFamily="{StaticResource FontBody}"
                            FontSize="14"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            Text="Tela Configurações aguardando especificação."
                            TextColor="{StaticResource OnSurface}" />
                    </VerticalStackLayout>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="{StaticResource OutlineVariant}" />

                    <VerticalStackLayout Spacing="6">
                        <Grid
                            Padding="8,6"
                            BackgroundColor="{StaticResource SurfaceContainerLow}"
                            ColumnDefinitions="*,Auto">
                            <Label
                                FontFamily="{StaticResource FontMono}"
                                FontAttributes="Bold"
                                FontSize="10"
                                Text="ESTADO"
                                TextColor="{StaticResource OnSurfaceVariant}"
                                CharacterSpacing="0.8" />
                            <Label
                                Grid.Column="1"
                                FontFamily="{StaticResource FontMono}"
                                FontSize="10"
                                Text="Não verificado"
                                TextColor="{StaticResource OnSurfaceVariant}" />
                        </Grid>
                        <Grid
                            Padding="8,6"
                            BackgroundColor="{StaticResource SurfaceContainerLow}"
                            ColumnDefinitions="*,Auto">
                            <Label
                                FontFamily="{StaticResource FontMono}"
                                FontAttributes="Bold"
                                FontSize="10"
                                Text="SISTEMA"
                                TextColor="{StaticResource OnSurfaceVariant}"
                                CharacterSpacing="0.8" />
                            <Label
                                Grid.Column="1"
                                FontFamily="{StaticResource FontMono}"
                                FontSize="10"
                                Text="Não verificado"
                                TextColor="{StaticResource OnSurfaceVariant}" />
                        </Grid>
                        <Grid
                            Padding="8,6"
                            BackgroundColor="{StaticResource SurfaceContainerLow}"
                            ColumnDefinitions="*,Auto">
                            <Label
                                FontFamily="{StaticResource FontMono}"
                                FontAttributes="Bold"
                                FontSize="10"
                                Text="TELEMETRIA"
                                TextColor="{StaticResource OnSurfaceVariant}"
                                CharacterSpacing="0.8" />
                            <Label
                                Grid.Column="1"
                                FontFamily="{StaticResource FontMono}"
                                FontSize="10"
                                Text="Não verificado"
                                TextColor="{StaticResource OnSurfaceVariant}" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentView>
