<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="InclinationTest.App.Views.ConfiguracoesView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:icons="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:layout="clr-namespace:InclinationTest.App.Components.Layout"
    BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*" BackgroundColor="{StaticResource Surface}">
        <layout:ScreenHeader Grid.Row="0" Title="Configurações">
            <layout:ScreenHeader.LeftContent>
                <Border
                    Padding="8,5"
                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                    StrokeShape="RoundRectangle 999"
                    StrokeThickness="0">
                    <HorizontalStackLayout Spacing="6">
                        <Ellipse
                            Fill="{StaticResource Primary}"
                            HeightRequest="7"
                            VerticalOptions="Center"
                            WidthRequest="7" />
                        <Label
                            FontFamily="{StaticResource FontMono}"
                            FontAttributes="Bold"
                            FontSize="10"
                            Text="ONLINE"
                            TextColor="{StaticResource Primary}"
                            CharacterSpacing="0.8" />
                    </HorizontalStackLayout>
                </Border>
            </layout:ScreenHeader.LeftContent>
        </layout:ScreenHeader>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,12,16,32" Spacing="16">

                <!-- SEÇÃO: TELEMETRIA E SENSORES -->
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontFamily="{StaticResource FontMono}"
                        FontSize="11"
                        FontAttributes="Bold"
                        Text="SENSORES E TELEMETRIA"
                        TextColor="{StaticResource Primary}"
                        CharacterSpacing="1.2" />

                    <Border
                        Padding="16"
                        BackgroundColor="{StaticResource SurfaceContainer}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border
                                    HeightRequest="36"
                                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="36">
                                    <Label
                                        FontFamily="{StaticResource FontIcons}"
                                        FontSize="20"
                                        HorizontalOptions="Center"
                                        Text="{x:Static icons:MaterialOutlined.Speed}"
                                        TextColor="{StaticResource Primary}"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        Text="Taxa de amostragem IMU"
                                        TextColor="{StaticResource OnSurface}" />
                                    <Label
                                        FontFamily="{StaticResource FontMono}"
                                        FontSize="11"
                                        Text="50 Hz (20 ms por captura)"
                                        TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="2"
                                    FontFamily="{StaticResource FontMono}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    Text="50 Hz"
                                    TextColor="{StaticResource Secondary}"
                                    VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource OutlineVariant}" />

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border
                                    HeightRequest="36"
                                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="36">
                                    <Label
                                        FontFamily="{StaticResource FontIcons}"
                                        FontSize="20"
                                        HorizontalOptions="Center"
                                        Text="{x:Static icons:MaterialOutlined.Filter_alt}"
                                        TextColor="{StaticResource Primary}"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        Text="Filtro passa-baixa náutico"
                                        TextColor="{StaticResource OnSurface}" />
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="11"
                                        Text="Suaviza oscilações de alta frequência do motor"
                                        TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="2" IsToggled="True" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- SEÇÃO: GRAVAÇÃO E INTERFACE -->
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontFamily="{StaticResource FontMono}"
                        FontSize="11"
                        FontAttributes="Bold"
                        Text="PREFERÊNCIAS DE ENSAIO"
                        TextColor="{StaticResource Primary}"
                        CharacterSpacing="1.2" />

                    <Border
                        Padding="16"
                        BackgroundColor="{StaticResource SurfaceContainer}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border
                                    HeightRequest="36"
                                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="36">
                                    <Label
                                        FontFamily="{StaticResource FontIcons}"
                                        FontSize="20"
                                        HorizontalOptions="Center"
                                        Text="{x:Static icons:MaterialOutlined.Wb_sunny}"
                                        TextColor="{StaticResource Primary}"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        Text="Manter tela ligada"
                                        TextColor="{StaticResource OnSurface}" />
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="11"
                                        Text="Evita bloqueio automático durante o ensaio"
                                        TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="2" IsToggled="True" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource OutlineVariant}" />

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border
                                    HeightRequest="36"
                                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="36">
                                    <Label
                                        FontFamily="{StaticResource FontIcons}"
                                        FontSize="20"
                                        HorizontalOptions="Center"
                                        Text="{x:Static icons:MaterialOutlined.Vibration}"
                                        TextColor="{StaticResource Primary}"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        Text="Feedback tátil (vibração)"
                                        TextColor="{StaticResource OnSurface}" />
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="11"
                                        Text="Vibra ao iniciar, pausar e salvar gravação"
                                        TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="2" IsToggled="True" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- SEÇÃO: ARMAZENAMENTO -->
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontFamily="{StaticResource FontMono}"
                        FontSize="11"
                        FontAttributes="Bold"
                        Text="ARMAZENAMENTO DE DADOS"
                        TextColor="{StaticResource Primary}"
                        CharacterSpacing="1.2" />

                    <Border
                        Padding="16"
                        BackgroundColor="{StaticResource SurfaceContainer}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    Text="Formato de exportação"
                                    TextColor="{StaticResource OnSurface}" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="{StaticResource FontMono}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    Text="PDF / CSV"
                                    TextColor="{StaticResource Secondary}" />
                            </Grid>
                            <Label
                                FontFamily="{StaticResource FontBody}"
                                FontSize="12"
                                Text="Os relatórios são gravados localmente em banco de dados isolado e protegidos contra falhas de energia ou queda de conexão."
                                TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- SEÇÃO: NUVEM E SINCRONIZAÇÃO (LOGIN OPCIONAL) -->
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontFamily="{StaticResource FontMono}"
                        FontSize="11"
                        FontAttributes="Bold"
                        Text="NUVEM E SINCRONIZAÇÃO (LOGIN OPCIONAL)"
                        TextColor="{StaticResource Primary}"
                        CharacterSpacing="1.2" />

                    <Border
                        Padding="16"
                        BackgroundColor="{StaticResource SurfaceContainer}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="14">
                            <!-- Status da Conta -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border
                                    HeightRequest="36"
                                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="36">
                                    <Label
                                        x:Name="CloudStatusIcon"
                                        FontFamily="{StaticResource FontIcons}"
                                        FontSize="20"
                                        HorizontalOptions="Center"
                                        Text="{x:Static icons:MaterialOutlined.Cloud_off}"
                                        TextColor="{StaticResource Primary}"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        Text="Status da Nuvem"
                                        TextColor="{StaticResource OnSurface}" />
                                    <Label
                                        x:Name="CloudAccountLabel"
                                        FontFamily="{StaticResource FontMono}"
                                        FontSize="11"
                                        Text="Modo Local (Offline) — Login opcional"
                                        TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                                <Border
                                    x:Name="CloudAuthActionBorder"
                                    Grid.Column="2"
                                    Padding="12,6"
                                    BackgroundColor="{StaticResource PrimaryContainer}"
                                    StrokeShape="RoundRectangle 999"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAuthActionTapped" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        x:Name="CloudAuthActionLabel"
                                        FontFamily="{StaticResource FontMono}"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        Text="CONECTAR"
                                        TextColor="{StaticResource OnPrimaryContainer}"
                                        CharacterSpacing="0.8" />
                                </Border>
                            </Grid>

                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource OutlineVariant}" />

                            <!-- Sincronização Automática -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border
                                    HeightRequest="36"
                                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="36">
                                    <Label
                                        FontFamily="{StaticResource FontIcons}"
                                        FontSize="20"
                                        HorizontalOptions="Center"
                                        Text="{x:Static icons:MaterialOutlined.Sync}"
                                        TextColor="{StaticResource Primary}"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        Text="Sincronização automática"
                                        TextColor="{StaticResource OnSurface}" />
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="11"
                                        Text="Salva medições na nuvem automaticamente"
                                        TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                                <Switch
                                    x:Name="AutoSyncSwitch"
                                    Grid.Column="2"
                                    IsToggled="True"
                                    Toggled="OnAutoSyncToggled"
                                    VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource OutlineVariant}" />

                            <!-- Sincronização Manual -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border
                                    HeightRequest="36"
                                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="36">
                                    <Label
                                        FontFamily="{StaticResource FontIcons}"
                                        FontSize="20"
                                        HorizontalOptions="Center"
                                        Text="{x:Static icons:MaterialOutlined.Cloud_upload}"
                                        TextColor="{StaticResource Secondary}"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        Text="Backup em nuvem agora"
                                        TextColor="{StaticResource OnSurface}" />
                                    <Label
                                        x:Name="SyncCountLabel"
                                        FontFamily="{StaticResource FontMono}"
                                        FontSize="11"
                                        Text="Toque para sincronizar relatórios pendentes"
                                        TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                                <Border
                                    Grid.Column="2"
                                    Padding="12,6"
                                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                    StrokeShape="RoundRectangle 999"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSyncNowTapped" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        FontFamily="{StaticResource FontMono}"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        Text="SINCRONIZAR"
                                        TextColor="{StaticResource Primary}"
                                        CharacterSpacing="0.8" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- SEÇÃO: SOBRE O SISTEMA -->
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontFamily="{StaticResource FontMono}"
                        FontSize="11"
                        FontAttributes="Bold"
                        Text="SOBRE O APLICATIVO"
                        TextColor="{StaticResource Primary}"
                        CharacterSpacing="1.2" />

                    <Border
                        Padding="16"
                        BackgroundColor="{StaticResource SurfaceContainer}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    FontFamily="{StaticResource FontDisplay}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    Text="Inclination Test"
                                    TextColor="{StaticResource OnSurface}" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="{StaticResource FontMono}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    Text="v1.0.0 (Release AOT)"
                                    TextColor="{StaticResource Primary}" />
                            </Grid>
                            <Label
                                FontFamily="{StaticResource FontBody}"
                                FontSize="12"
                                Text="Sistema de telemetria marítima desenvolvido para provas de mar, ensaios de estabilidade, medições de banda (Roll) e compasso (Trim)."
                                TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- MODAL DE LOGIN / CADASTRO OPCIONAL -->
        <Grid
            x:Name="LoginOverlay"
            BackgroundColor="{StaticResource Scrim}"
            IsVisible="False"
            ZIndex="30">
            <BoxView BackgroundColor="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseLoginTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border
                Margin="20"
                Padding="24"
                BackgroundColor="{StaticResource SurfaceContainer}"
                MaximumWidthRequest="420"
                StrokeShape="RoundRectangle 24"
                StrokeThickness="0"
                VerticalOptions="Center">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border
                            HeightRequest="36"
                            BackgroundColor="#3348efef"
                            StrokeShape="RoundRectangle 999"
                            StrokeThickness="0"
                            WidthRequest="36">
                            <Label
                                FontFamily="{StaticResource FontIcons}"
                                FontSize="20"
                                HorizontalOptions="Center"
                                Text="{x:Static icons:MaterialOutlined.Cloud_done}"
                                TextColor="{StaticResource Primary}"
                                VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label
                                FontFamily="{StaticResource FontDisplay}"
                                FontSize="17"
                                FontAttributes="Bold"
                                Text="Nuvem de Telemetria"
                                TextColor="{StaticResource OnSurface}" />
                            <Label
                                FontFamily="{StaticResource FontMono}"
                                FontSize="10"
                                Text="LOGIN OPCIONAL • MODO OFFLINE SEGURO"
                                TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                        <Label
                            Grid.Column="2"
                            FontFamily="{StaticResource FontIcons}"
                            FontSize="22"
                            Text="{x:Static icons:MaterialOutlined.Close}"
                            TextColor="{StaticResource OnSurfaceVariant}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseLoginTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <Label
                        FontFamily="{StaticResource FontBody}"
                        FontSize="12"
                        LineHeight="1.35"
                        Text="O uso da nuvem é opcional. Seus dados permanecem salvos no dispositivo mesmo sem conta. Conecte-se para backup remoto e compartilhamento."
                        TextColor="{StaticResource OnSurfaceVariant}" />

                    <VerticalStackLayout Spacing="6">
                        <Label
                            FontFamily="{StaticResource FontMono}"
                            FontSize="12"
                            Text="E-mail"
                            TextColor="{StaticResource OnSurfaceVariant}" />
                        <Border
                            Padding="12,0"
                            BackgroundColor="{StaticResource SurfaceContainerLowest}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0">
                            <Entry
                                x:Name="EmailEntry"
                                HeightRequest="46"
                                Keyboard="Email"
                                Placeholder="capitao@embarcacao.com" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label
                            FontFamily="{StaticResource FontMono}"
                            FontSize="12"
                            Text="Senha"
                            TextColor="{StaticResource OnSurfaceVariant}" />
                        <Border
                            Padding="12,0"
                            BackgroundColor="{StaticResource SurfaceContainerLowest}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0">
                            <Entry
                                x:Name="PasswordEntry"
                                HeightRequest="46"
                                IsPassword="True"
                                Placeholder="••••••••" />
                        </Border>
                    </VerticalStackLayout>

                    <Label
                        x:Name="LoginErrorLabel"
                        FontFamily="{StaticResource FontBody}"
                        FontSize="12"
                        IsVisible="False"
                        TextColor="{StaticResource Error}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                        <Border
                            Padding="0,14"
                            BackgroundColor="{StaticResource SurfaceContainerHigh}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseLoginTapped" />
                            </Border.GestureRecognizers>
                            <Label
                                FontFamily="{StaticResource FontBody}"
                                FontSize="13"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                Text="Ficar Offline"
                                TextColor="{StaticResource OnSurface}" />
                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="0,14"
                            BackgroundColor="{StaticResource Primary}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSubmitLoginTapped" />
                            </Border.GestureRecognizers>
                            <Label
                                FontFamily="{StaticResource FontBody}"
                                FontSize="13"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                Text="Entrar / Conectar"
                                TextColor="{StaticResource OnPrimary}" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentView>
