<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="InclinationTest.App.Views.ConfiguracoesView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:icons="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:layout="clr-namespace:InclinationTest.App.Components.Layout"
    BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*" BackgroundColor="{StaticResource Surface}">
        <layout:ScreenHeader Grid.Row="0" Title="Configurações">
            <layout:ScreenHeader.LeftContent>
                <Border
                    Padding="8,5"
                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                    StrokeShape="RoundRectangle 999"
                    StrokeThickness="0">
                    <HorizontalStackLayout Spacing="6">
                        <Ellipse
                            Fill="{StaticResource Primary}"
                            HeightRequest="7"
                            VerticalOptions="Center"
                            WidthRequest="7" />
                        <Label
                            FontFamily="{StaticResource FontMono}"
                            FontAttributes="Bold"
                            FontSize="10"
                            Text="ONLINE"
                            TextColor="{StaticResource Primary}"
                            CharacterSpacing="0.8" />
                    </HorizontalStackLayout>
                </Border>
            </layout:ScreenHeader.LeftContent>
        </layout:ScreenHeader>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,12,16,32" Spacing="16">

                <!-- SEÇÃO: TELEMETRIA E SENSORES -->
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontFamily="{StaticResource FontMono}"
                        FontSize="11"
                        FontAttributes="Bold"
                        Text="SENSORES E TELEMETRIA"
                        TextColor="{StaticResource Primary}"
                        CharacterSpacing="1.2" />

                    <Border
                        Padding="16"
                        BackgroundColor="{StaticResource SurfaceContainer}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border
                                    HeightRequest="36"
                                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="36">
                                    <Label
                                        FontFamily="{StaticResource FontIcons}"
                                        FontSize="20"
                                        HorizontalOptions="Center"
                                        Text="{x:Static icons:MaterialOutlined.Speed}"
                                        TextColor="{StaticResource Primary}"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        Text="Taxa de amostragem IMU"
                                        TextColor="{StaticResource OnSurface}" />
                                    <Label
                                        FontFamily="{StaticResource FontMono}"
                                        FontSize="11"
                                        Text="50 Hz (20 ms por captura)"
                                        TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="2"
                                    FontFamily="{StaticResource FontMono}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    Text="50 Hz"
                                    TextColor="{StaticResource Secondary}"
                                    VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource OutlineVariant}" />

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border
                                    HeightRequest="36"
                                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="36">
                                    <Label
                                        FontFamily="{StaticResource FontIcons}"
                                        FontSize="20"
                                        HorizontalOptions="Center"
                                        Text="{x:Static icons:MaterialOutlined.Filter_alt}"
                                        TextColor="{StaticResource Primary}"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        Text="Filtro passa-baixa náutico"
                                        TextColor="{StaticResource OnSurface}" />
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="11"
                                        Text="Suaviza oscilações de alta frequência do motor"
                                        TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="2" IsToggled="True" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- SEÇÃO: GRAVAÇÃO E INTERFACE -->
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontFamily="{StaticResource FontMono}"
                        FontSize="11"
                        FontAttributes="Bold"
                        Text="PREFERÊNCIAS DE ENSAIO"
                        TextColor="{StaticResource Primary}"
                        CharacterSpacing="1.2" />

                    <Border
                        Padding="16"
                        BackgroundColor="{StaticResource SurfaceContainer}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border
                                    HeightRequest="36"
                                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="36">
                                    <Label
                                        FontFamily="{StaticResource FontIcons}"
                                        FontSize="20"
                                        HorizontalOptions="Center"
                                        Text="{x:Static icons:MaterialOutlined.Wb_sunny}"
                                        TextColor="{StaticResource Primary}"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        Text="Manter tela ligada"
                                        TextColor="{StaticResource OnSurface}" />
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="11"
                                        Text="Evita bloqueio automático durante o ensaio"
                                        TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="2" IsToggled="True" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource OutlineVariant}" />

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border
                                    HeightRequest="36"
                                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="36">
                                    <Label
                                        FontFamily="{StaticResource FontIcons}"
                                        FontSize="20"
                                        HorizontalOptions="Center"
                                        Text="{x:Static icons:MaterialOutlined.Vibration}"
                                        TextColor="{StaticResource Primary}"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        Text="Feedback tátil (vibração)"
                                        TextColor="{StaticResource OnSurface}" />
                                    <Label
                                        FontFamily="{StaticResource FontBody}"
                                        FontSize="11"
                                        Text="Vibra ao iniciar, pausar e salvar gravação"
                                        TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="2" IsToggled="True" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- SEÇÃO: ARMAZENAMENTO -->
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontFamily="{StaticResource FontMono}"
                        FontSize="11"
                        FontAttributes="Bold"
                        Text="ARMAZENAMENTO DE DADOS"
                        TextColor="{StaticResource Primary}"
                        CharacterSpacing="1.2" />

                    <Border
                        Padding="16"
                        BackgroundColor="{StaticResource SurfaceContainer}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    FontFamily="{StaticResource FontBody}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    Text="Formato de exportação"
                                    TextColor="{StaticResource OnSurface}" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="{StaticResource FontMono}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    Text="PDF / CSV"
                                    TextColor="{StaticResource Secondary}" />
                            </Grid>
                            <Label
                                FontFamily="{StaticResource FontBody}"
                                FontSize="12"
                                Text="Os relatórios são gravados localmente em banco de dados isolado e protegidos contra falhas de energia ou queda de conexão."
                                TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- SEÇÃO: SOBRE O SISTEMA -->
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontFamily="{StaticResource FontMono}"
                        FontSize="11"
                        FontAttributes="Bold"
                        Text="SOBRE O APLICATIVO"
                        TextColor="{StaticResource Primary}"
                        CharacterSpacing="1.2" />

                    <Border
                        Padding="16"
                        BackgroundColor="{StaticResource SurfaceContainer}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    FontFamily="{StaticResource FontDisplay}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    Text="Inclination Test"
                                    TextColor="{StaticResource OnSurface}" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="{StaticResource FontMono}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    Text="v1.0.0 (Release AOT)"
                                    TextColor="{StaticResource Primary}" />
                            </Grid>
                            <Label
                                FontFamily="{StaticResource FontBody}"
                                FontSize="12"
                                Text="Sistema de telemetria marítima desenvolvido para provas de mar, ensaios de estabilidade, medições de banda (Roll) e compasso (Trim)."
                                TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentView>
